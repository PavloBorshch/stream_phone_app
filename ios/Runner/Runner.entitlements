<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- TODO: replace with a real App Group id once the app has a real (non
	     com.example.*) bundle identifier - see ios/BroadcastExtension/README
	     notes in the screencast implementation plan. Must match the id used
	     in ScreencastChannel.swift and BroadcastExtension/SampleHandler.swift. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.example.stream_phone_cam.shared</string>
	</array>
	<!-- TODO: Universal Link for the Firebase email sign-in link
	     (see AuthRepository doc comment). Requires a paid Apple Developer
	     team so Xcode can add this via Signing & Capabilities -> Associated
	     Domains (which also writes the apple-app-site-association
	     requirement) - cannot be completed by hand-editing this file alone. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:stream-phone-cam.firebaseapp.com</string>
	</array>
</dict>
</plist>
